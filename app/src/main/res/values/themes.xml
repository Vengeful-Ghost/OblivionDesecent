<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme: dark fantasy gothic, no action bar -->
    <style name="Base.Theme.OblivionDescent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorPrimary">@color/gold_base</item>
        <item name="colorPrimaryVariant">@color/gold_deep</item>
        <item name="colorOnPrimary">@color/bg_deepest</item>
        <item name="colorSecondary">@color/crimson_base</item>
        <item name="colorOnSecondary">@color/bone_white</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/bone_white</item>
        <item name="colorAccent">@color/gold_bright</item>
        <item name="android:textColorPrimary">@color/bone_white</item>
        <item name="android:textColorSecondary">@color/bone_dim</item>
        <item name="android:textColorHint">@color/bone_muted</item>
        <item name="android:fontFamily">@font/pixel</item>
    </style>

    <style name="Theme.OblivionDescent" parent="Base.Theme.OblivionDescent" />

    <!-- Game screens: the window behind the cutout padding is dark, not the default grey -->
    <style name="Theme.OblivionDescent.Screen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_deepest</item>
    </style>

    <!-- Loading dialog: transparent so our custom drawable shows through -->
    <style name="LoadingDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.78</item>
    </style>

</resources>
