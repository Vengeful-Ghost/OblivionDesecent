<?xml version="1.0" encoding="utf-8"?>
<!-- Pixelify Sans (SIL OFL 1.1, assets/licenses/PixelifySans-OFL.txt): every piece of text in the game, so
     menus, dialogs, buttons and the HUD read as pixel art like the world. The static regular and bold files
     from Google Fonts: the variable font's overlapping outlines can draw with holes in some renderers. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/pixelify_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/pixelify_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400"/>
    <font
        android:font="@font/pixelify_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/pixelify_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700"/>
</font-family>
