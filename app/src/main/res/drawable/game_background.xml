<?xml version="1.0" encoding="utf-8"?>
<!-- Backdrop for menu / loading screens: warm-charcoal vertical gradient -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/bg_deepest"
                android:centerColor="@color/bg_base"
                android:endColor="@color/bg_surface"/>
        </shape>
    </item>
</selector>
