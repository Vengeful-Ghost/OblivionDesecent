<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog frame: an old stone tablet in a worn iron band; Wear adds its cracks, broken corners and moss -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The dark gap around the stone -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stone_crack"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>

    <!-- Worn iron band -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/border_gold"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>

    <!-- Recess inside the band -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/stone_crack"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>

    <!-- Stone face, a little lighter at the top as if lit by a torch -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#24211D"
                android:centerColor="@color/bg_surface"
                android:endColor="#131210"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>

</layer-list>
