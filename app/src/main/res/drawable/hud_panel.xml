<?xml version="1.0" encoding="utf-8"?>
<!-- Small HUD plate (floor/gold/kills): dark stone in a worn iron edge, one corner chipped -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border_gold_inner"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E6262320"
                android:endColor="#E60C0B0A"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>

    <item android:drawable="@drawable/wear_chip" android:gravity="top|end"
        android:width="13dp" android:height="10dp"/>

</layer-list>
