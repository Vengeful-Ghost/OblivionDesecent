<?xml version="1.0" encoding="utf-8"?>
<!-- Small gold-trimmed panel for HUD elements (floor/gold/kills cluster) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border_gold_inner"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E61E1813"
                android:endColor="#E60A0807"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>

</layer-list>
