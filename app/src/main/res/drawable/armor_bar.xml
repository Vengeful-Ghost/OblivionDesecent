<?xml version="1.0" encoding="utf-8"?>
<!-- Armor bar: gold-trimmed frame, steel-blue fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/border_gold"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
            <item
                android:left="1dp" android:top="1dp"
                android:right="1dp" android:bottom="1dp">
                <shape>
                    <solid android:color="@color/armor_blue_track"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:type="linear"
                    android:angle="270"
                    android:startColor="@color/armor_blue"
                    android:endColor="@color/armor_blue_dim"/>
                <corners android:radius="5dp"/>
            </shape>
        </clip>
    </item>

</layer-list>
