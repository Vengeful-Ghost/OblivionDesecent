<?xml version="1.0" encoding="utf-8"?>
<!-- Gothic primary button: dark interior, double gold trim, gold ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gold_translucent_strong">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_bright"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>

    <item>
        <selector>
            <!-- Pressed state: brighter gold glow on interior -->
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@color/gold_bright"/>
                            <corners android:radius="10dp"/>
                        </shape>
                    </item>
                    <item
                        android:left="2dp" android:top="2dp"
                        android:right="2dp" android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:type="linear"
                                android:angle="270"
                                android:startColor="#4A2A0A"
                                android:endColor="#1A0F05"/>
                            <corners android:radius="8dp"/>
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- Default state: tarnished gold double-border, dark gradient -->
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@color/border_gold_outer"/>
                            <corners android:radius="10dp"/>
                        </shape>
                    </item>
                    <item
                        android:left="1dp" android:top="1dp"
                        android:right="1dp" android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/border_gold"/>
                            <corners android:radius="9dp"/>
                        </shape>
                    </item>
                    <item
                        android:left="3dp" android:top="3dp"
                        android:right="3dp" android:bottom="3dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/gold_deep"/>
                            <corners android:radius="7dp"/>
                        </shape>
                    </item>
                    <item
                        android:left="4dp" android:top="4dp"
                        android:right="4dp" android:bottom="4dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:type="linear"
                                android:angle="270"
                                android:startColor="#2A1F14"
                                android:centerColor="#1A130D"
                                android:endColor="#0A0807"/>
                            <corners android:radius="6dp"/>
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>

</ripple>
