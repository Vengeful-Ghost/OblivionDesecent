<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary panel / row background: single gold hairline, darker interior -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border_gold_inner"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/bg_surface_alt"
                android:endColor="@color/bg_base"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>

</layer-list>
