<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary panel / row background: a recessed stone panel with a hairline crack -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border_gold_inner"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/bg_base"
                android:endColor="@color/bg_surface_alt"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>

    <item android:drawable="@drawable/wear_crack" android:gravity="bottom|end"
        android:right="8dp" android:bottom="1dp" android:width="26dp" android:height="14dp"/>

</layer-list>
