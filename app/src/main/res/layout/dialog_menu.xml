<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/space_lg">

    <!-- Shrinks the card to fit the screen; scrolls only if it is far too tall -->
    <com.example.obliviondescent.FitScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/dialog_menu"
        android:layout_width="@dimen/card_width_md"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:tag="stone"
        android:padding="@dimen/space_xl"
        android:layout_gravity="center"
        android:animation="@anim/dialog_open">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:id="@+id/GameTitleBack"
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Oblivion Descent"
                android:textAllCaps="true"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeMaxTextSize="@dimen/text_title"
                app:autoSizeStepGranularity="1sp"
                android:textColor="@color/shadow_soft"
                android:gravity="center"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:shadowColor="@color/shadow_hard"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:translationX="3dp"
                android:translationY="3dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/GameTitleFront"
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Oblivion Descent"
                android:textAllCaps="true"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeMaxTextSize="@dimen/text_title"
                app:autoSizeStepGranularity="1sp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:gravity="center"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="14"
                android:animation="@anim/glow_pulse"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_md"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resume"
            style="@style/OD.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Resume"
            android:stateListAnimator="@animator/button_elevation_anim"
            android:translationZ="4dp"
            android:layout_marginBottom="@dimen/space_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Settings"
            android:textColor="@color/gold_glow"
            android:layout_marginBottom="@dimen/space_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_main_menu"
            style="@style/OD.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Main Menu" />
    </LinearLayout>

    </FrameLayout>

    </com.example.obliviondescent.FitScrollView>

</FrameLayout>
