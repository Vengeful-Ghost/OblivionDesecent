<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="20dp">

        <!-- Header: close + name -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btn_close_action"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:text="✕"
                android:textColor="#888888"
                android:textSize="18sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/action_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingHorizontal="36dp"
                android:text="Item Name"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Type + rarity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/action_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEAPON"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                tools:ignore="HardcodedText"/>

            <View android:layout_width="8dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/action_rarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMON"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/action_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="12dp"/>

        <!-- Stats -->
        <TextView
            android:id="@+id/action_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="16dp"/>

        <!-- Action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Use"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="22dp"
            app:strokeWidth="2dp"
            app:strokeColor="#FFD700"
            app:backgroundTint="@color/darkGray"
            tools:ignore="HardcodedText"/>

        <!-- Remove button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remove"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Remove"
            android:textAllCaps="false"
            android:textColor="#FF6666"
            android:textSize="13sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FF3333"
            app:backgroundTint="#1A0000"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

</FrameLayout>