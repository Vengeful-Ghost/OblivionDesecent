<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/space_md">

    <!-- Only scrolls if the card is taller than the screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        style="@style/OD.Card"
        android:layout_width="@dimen/card_width_lg"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:animation="@anim/dialog_open">

        <!-- Header: close + name -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm">

            <ImageButton
                android:id="@+id/btn_close_action"
                style="@style/OD.CloseButton"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="Close"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/action_name"
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/touch_min"
                android:text="Item Name"
                android:textSize="@dimen/text_heading"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:maxLines="2"
                android:ellipsize="end"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Two panes for landscape: details + actions | stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <!-- Type + rarity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_md">

            <TextView
                android:id="@+id/action_type"
                style="@style/OD.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEAPON"
                android:textColor="@color/bone_white"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs"
                tools:ignore="HardcodedText"/>

            <View android:layout_width="@dimen/space_sm" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/action_rarity"
                style="@style/OD.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMON"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/action_description"
            style="@style/OD.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/bone_dim"
            android:textStyle="italic"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="@dimen/space_md"/>

        <!-- Action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            style="@style/OD.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Use"
            android:stateListAnimator="@animator/button_elevation_anim"
            android:translationZ="4dp"
            tools:ignore="HardcodedText"/>

        <!-- Sell button (text set in Java with the gold it fetches) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remove"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_md"
            android:text="Sell"
            android:textSize="@dimen/text_small"
            app:icon="@drawable/ic_coin"
            tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:background="@color/divider_gold"/>

        <!-- Stats: rows inflated in Java -->
        <LinearLayout
            android:id="@+id/action_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"/>

        </LinearLayout>

    </LinearLayout>

    </FrameLayout>

    </ScrollView>

</FrameLayout>
