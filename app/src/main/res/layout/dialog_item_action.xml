<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="22dp"
        android:animation="@anim/dialog_open">

        <!-- Header: close + name -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btn_close_action"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="start|center_vertical"
                android:text="✕"
                android:textColor="@color/bone_dim"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/action_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingHorizontal="40dp"
                android:text="Item Name"
                android:textColor="@color/gold_bright"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.06"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:maxLines="2"
                android:ellipsize="end"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Type + rarity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/action_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEAPON"
                android:textColor="@color/bone_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.22"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                tools:ignore="HardcodedText"/>

            <View android:layout_width="8dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/action_rarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMON"
                android:textColor="@color/bone_dim"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.22"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/action_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/bone_dim"
            android:textSize="13sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="14dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="14dp"/>

        <!-- Stats -->
        <TextView
            android:id="@+id/action_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/bone_white"
            android:textSize="13sp"
            android:fontFamily="serif"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="18dp"/>

        <!-- Action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Use"
            android:textAllCaps="false"
            android:textColor="@color/gold_glow"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_login"
            android:stateListAnimator="@animator/button_elevation_anim"
            android:translationZ="4dp"
            tools:ignore="HardcodedText"/>

        <!-- Remove button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remove"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="Remove"
            android:textAllCaps="false"
            android:textColor="@color/crimson_glow"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_gothic_danger"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

</FrameLayout>
