<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/dialog_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inv_item_name"
            style="@style/OD.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/inv_item_subtitle"
            style="@style/OD.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEAPON"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

    <TextView
        android:id="@+id/inv_item_quantity"
        style="@style/OD.Text.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x2"
        android:visibility="gone"
        android:layout_marginEnd="@dimen/space_md"/>

    <TextView
        android:id="@+id/inv_equipped_badge"
        style="@style/OD.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="EQUIPPED"
        android:textColor="@color/success_green"
        android:visibility="gone"/>

</LinearLayout>
