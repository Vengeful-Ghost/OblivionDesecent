<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/dialog_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inv_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textColor="@color/bone_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/inv_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEAPON"
            android:textColor="@color/bone_muted"
            android:textSize="10sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/inv_item_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x2"
        android:textColor="@color/gold_bright"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:visibility="gone"
        android:layout_marginEnd="10dp"/>

    <TextView
        android:id="@+id/inv_equipped_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EQUIPPED"
        android:textColor="@color/success_green"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.18"
        android:visibility="gone"/>

</LinearLayout>
