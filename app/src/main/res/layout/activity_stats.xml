<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/game_background"
    android:padding="12dp">

    <!-- LEFT: Personal Stats Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="16dp"
        android:layout_marginEnd="8dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Stats"
            android:textAllCaps="true"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/gold_bright"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:shadowColor="@color/gold_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:layout_marginBottom="12dp"
            tools:ignore="HardcodedText"/>

        <!-- Lifetime / Current Game toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/dialog_bg"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_lifetime"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Lifetime"
                android:textColor="@color/gold_bright"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/tab_current"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Current Game"
                android:textColor="@color/bone_muted"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="12dp"/>

        <!-- Stats scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_stats"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="@color/gold_glow"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_gothic_secondary"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- RIGHT: Leaderboard Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leaderboard"
            android:textAllCaps="true"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/gold_bright"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:shadowColor="@color/gold_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:layout_marginBottom="12dp"
            tools:ignore="HardcodedText"/>

        <!-- Global / Following toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/dialog_bg"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_global"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Global"
                android:textColor="@color/gold_bright"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/tab_following"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Following"
                android:textColor="@color/bone_muted"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Search bar (visible on Following tab) -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/dialog_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <android.widget.EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:hint="Search username..."
                android:textColor="@color/bone_white"
                android:textColorHint="@color/bone_muted"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:background="@null"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Search"
                android:textAllCaps="false"
                android:textColor="@color/gold_glow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.06"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                app:backgroundTint="@null"
                android:background="@drawable/btn_gothic_secondary"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="8dp"/>

        <!-- RecyclerView for leaderboard -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboard_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"/>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/leaderboard_loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/gold_bright"
            android:visibility="gone"/>

        <!-- Empty state -->
        <TextView
            android:id="@+id/leaderboard_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No players found"
            android:textColor="@color/bone_faint"
            android:textSize="14sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingVertical="32dp"
            android:visibility="gone"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

</LinearLayout>