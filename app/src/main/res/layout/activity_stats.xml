<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#1E1E1E"
    android:padding="12dp">

    <!-- LEFT: Personal Stats Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="16dp"
        android:layout_marginEnd="8dp">

        <!-- Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Stats"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textColor="#33000000"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Stats"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textColor="#FFD700"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:shadowColor="#FFB700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Lifetime / Current Game toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/dialog_bg"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_lifetime"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Lifetime"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/tab_current"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Current Game"
                android:textColor="#666666"
                android:textSize="13sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="12dp"/>

        <!-- Stats scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_stats"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="22dp"
            app:strokeWidth="1dp"
            app:strokeColor="#444444"
            app:backgroundTint="@color/darkGray"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- RIGHT: Leaderboard Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="16dp">

        <!-- Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Leaderboard"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textColor="#33000000"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Leaderboard"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textColor="#FFD700"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:shadowColor="#FFB700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Global / Following toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/dialog_bg"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_global"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Global"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/tab_following"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Following"
                android:textColor="#666666"
                android:textSize="13sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Search bar (visible on Following tab) -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/dialog_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <android.widget.EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:hint="Search username..."
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="13sp"
                android:background="@null"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Search"
                android:textAllCaps="false"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFD700"
                app:backgroundTint="@color/darkGray"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="8dp"/>

        <!-- RecyclerView for leaderboard -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboard_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"/>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/leaderboard_loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="#FFD700"
            android:visibility="gone"/>

        <!-- Empty state -->
        <TextView
            android:id="@+id/leaderboard_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No players found"
            android:textColor="#444444"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingVertical="32dp"
            android:visibility="gone"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

</LinearLayout>