<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/game_background"
    android:padding="@dimen/space_md">

    <!-- LEFT: Personal Stats Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_sm">

        <!-- Title -->
        <TextView
            style="@style/OD.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Stats"
            android:textAllCaps="true"
            android:gravity="center"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="@dimen/text_title"
            app:autoSizeStepGranularity="1sp"
            android:layout_marginBottom="@dimen/space_md"
            tools:ignore="HardcodedText"/>

        <!-- Lifetime / Current Game toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/dialog_bg"
            android:padding="@dimen/space_xs">

            <TextView
                android:id="@+id/tab_lifetime"
                style="@style/OD.Text.Tab"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="Lifetime"
                android:textColor="@color/gold_bright"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/tab_current"
                style="@style/OD.Text.Tab"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="Current Game"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_md"/>

        <!-- Stats scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_stats"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_md"
            android:text="Back"
            app:icon="@drawable/ic_back"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- RIGHT: Leaderboard Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="@dimen/space_lg">

        <!-- Title -->
        <TextView
            style="@style/OD.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leaderboard"
            android:textAllCaps="true"
            android:gravity="center"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="@dimen/text_title"
            app:autoSizeStepGranularity="1sp"
            android:layout_marginBottom="@dimen/space_md"
            tools:ignore="HardcodedText"/>

        <!-- Global / Following toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_sm"
            android:background="@drawable/dialog_bg"
            android:padding="@dimen/space_xs">

            <TextView
                android:id="@+id/tab_global"
                style="@style/OD.Text.Tab"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="Global"
                android:textColor="@color/gold_bright"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/tab_following"
                style="@style/OD.Text.Tab"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="Following"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Search bar (visible on Following tab) -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_sm"
            android:visibility="gone">

            <android.widget.EditText
                android:id="@+id/search_input"
                style="@style/OD.Input"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:hint="Search username..."
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search"
                style="@style/OD.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_sm"
                android:text="Search"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <!-- RecyclerView for leaderboard -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboard_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"/>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/leaderboard_loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/gold_bright"
            android:visibility="gone"/>

        <!-- Empty state -->
        <TextView
            android:id="@+id/leaderboard_empty"
            style="@style/OD.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No players found"
            android:textColor="@color/bone_faint"
            android:textStyle="italic"
            android:gravity="center"
            android:paddingVertical="@dimen/space_xxl"
            android:visibility="gone"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

</LinearLayout>