<?xml version="1.0" encoding="utf-8"?>
<!-- One daily quest: title and progress on the left, the Souls to claim on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/space_sm"
    android:paddingHorizontal="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quest_title"
                style="@style/OD.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Slay 60 enemies"/>

            <TextView
                android:id="@+id/quest_progress"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_small"
                tools:text="12 / 60"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/quest_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/space_xs"
            android:progressTint="@color/gold_bright"
            android:progressBackgroundTint="@color/border_gold_outer"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quest_claim"
        style="@style/OD.Button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_md"
        android:textSize="@dimen/text_small"
        tools:text="+25 Souls"/>

</LinearLayout>
