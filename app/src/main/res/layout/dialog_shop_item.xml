<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:layout_margin="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/slot_inventory">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_md"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/item_name"
            style="@style/OD.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/item_type_badge"
                style="@style/OD.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WEAPON"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/item_price"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="50"
                android:textSize="@dimen/text_small"
                android:drawableStart="@drawable/ic_coin"
                android:drawablePadding="@dimen/space_xs"
                android:drawableTint="@color/gold_bright"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
