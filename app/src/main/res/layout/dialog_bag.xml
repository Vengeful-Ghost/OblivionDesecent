<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/dialog_inventory_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="26dp"
        android:minWidth="520dp"
        android:animation="@anim/dialog_open">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/InventoryTitleBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textAllCaps="true"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="#66000000"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:translationX="3dp"
                android:translationY="3dp" />

            <TextView
                android:id="@+id/InventoryTitleFront"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textAllCaps="true"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="@color/gold_bright"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="14" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="14dp"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <GridLayout
                android:id="@+id/weapon_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:columnCount="5"
                app:alignmentMode="alignMargins"
                app:columnOrderPreserved="false"
                android:orientation="horizontal"
                android:padding="4dp" />

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</FrameLayout>
