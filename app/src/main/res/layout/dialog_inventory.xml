<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_overlay"
    android:padding="@dimen/space_md">

    <!-- LEFT: Equipped Panel -->
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:tag="stone"
        android:padding="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_md">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipped"
                android:textAllCaps="true"
                android:textSize="@dimen/text_heading"
                android:textColor="@color/shadow_soft"
                android:shadowColor="@color/shadow_hard"
                android:gravity="center"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipped"
                android:textAllCaps="true"
                android:textSize="@dimen/text_heading"
                android:gravity="center"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <!-- Compact one-line slots, so all five fit without scrolling -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Weapon slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:src="@drawable/ic_sword"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/txt_equipped_weapon"
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fists"
                        android:textSize="@dimen/text_small"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:ignore="HardcodedText"/>

                </LinearLayout>

                <!-- Head slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:src="@drawable/ic_helmet"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/txt_equipped_head"
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No helmet"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/bone_muted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:ignore="HardcodedText"/>

                </LinearLayout>

                <!-- Chest slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:src="@drawable/ic_chest_armor"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/txt_equipped_chest"
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No chest armor"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/bone_muted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:ignore="HardcodedText"/>

                </LinearLayout>

                <!-- Legs slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:src="@drawable/ic_leg_armor"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/txt_equipped_legs"
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No leg armor"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/bone_muted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:ignore="HardcodedText"/>

                </LinearLayout>

                <!-- Boots slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:src="@drawable/ic_boots"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/txt_equipped_boots"
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No boots"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/bone_muted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:ignore="HardcodedText"/>

                </LinearLayout>

                <!-- Relic slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:src="@drawable/ic_trophy"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/txt_equipped_relic"
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No relic"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/bone_muted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:ignore="HardcodedText"/>

                </LinearLayout>

            </LinearLayout>

        <!-- Close button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_inventory"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Close"
            android:textColor="@color/bone_dim"
            android:textSize="@dimen/text_small"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/bone_dim"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- RIGHT: Inventory Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:tag="stone"
        android:padding="@dimen/space_lg">

        <!-- Header: filter tabs + sort, one row so the grid gets the height -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                android:id="@+id/filter_all"
                style="@style/OD.Text.Tab"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:minWidth="@dimen/touch_min"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:text="ALL"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/gold_bright"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <!-- Icon tabs: the top padding centres the icon in the 48dp tab -->
            <TextView
                android:id="@+id/filter_weapons"
                style="@style/OD.Text.Tab"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:paddingTop="14dp"
                android:drawableTop="@drawable/ic_sword"
                android:contentDescription="Weapons"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_armor"
                style="@style/OD.Text.Tab"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:paddingTop="14dp"
                android:drawableTop="@drawable/ic_chest_armor"
                android:contentDescription="Armor"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_consumables"
                style="@style/OD.Text.Tab"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:paddingTop="14dp"
                android:drawableTop="@drawable/ic_heart"
                android:contentDescription="Consumables"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_perks"
                style="@style/OD.Text.Tab"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:paddingTop="14dp"
                android:drawableTop="@drawable/ic_level"
                android:contentDescription="Perks"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_relics"
                style="@style/OD.Text.Tab"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:paddingTop="14dp"
                android:drawableTop="@drawable/ic_trophy"
                android:contentDescription="Relics"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort_inventory"
                style="@style/OD.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_sm"
                android:text="Sort: Type"
                android:textSize="@dimen/text_caption"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <!-- One page of square item cells, sized in Java to fit (no scrolling) -->
        <LinearLayout
            android:id="@+id/inventory_list_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"/>

        <!-- Pages -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_page_prev"
                style="@style/OD.Button.Secondary"
                android:layout_width="64dp"
                android:layout_height="@dimen/touch_min"
                android:minWidth="0dp"
                android:text="‹"
                android:textSize="@dimen/text_heading"
                android:contentDescription="Previous page"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/txt_inventory_page"
                style="@style/OD.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:gravity="center"
                android:text="1 / 1"
                tools:ignore="HardcodedText"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_page_next"
                style="@style/OD.Button.Secondary"
                android:layout_width="64dp"
                android:layout_height="@dimen/touch_min"
                android:minWidth="0dp"
                android:text="›"
                android:textSize="@dimen/text_heading"
                android:contentDescription="Next page"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
