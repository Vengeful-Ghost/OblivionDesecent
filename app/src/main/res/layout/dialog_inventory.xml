<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_overlay"
    android:padding="12dp">

    <!-- LEFT: Equipped Panel -->
    <LinearLayout
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="16dp"
        android:layout_marginEnd="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipped"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="#66000000"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipped"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="@color/gold_bright"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="14dp"/>

        <!-- Weapon slot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚔  WEAPON"
                android:textColor="@color/border_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.2"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/txt_equipped_weapon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fists"
                android:textColor="@color/bone_white"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:layout_marginTop="3dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Head slot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪖  HEAD"
                android:textColor="@color/border_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.2"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/txt_equipped_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/bone_faint"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:layout_marginTop="3dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Chest slot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧥  CHEST"
                android:textColor="@color/border_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.2"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/txt_equipped_chest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/bone_faint"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:layout_marginTop="3dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Legs slot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩲  LEGS"
                android:textColor="@color/border_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.2"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/txt_equipped_legs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/bone_faint"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:layout_marginTop="3dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Boots slot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👢  BOOTS"
                android:textColor="@color/border_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.2"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/txt_equipped_boots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/bone_faint"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:layout_marginTop="3dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Close button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_inventory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/bone_dim"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_gothic_secondary"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- RIGHT: Inventory Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="#66000000"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="@color/gold_bright"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Filter tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/filter_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ALL"
                android:textColor="@color/gold_bright"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_weapons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WEAPONS"
                android:textColor="@color/bone_muted"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_armor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ARMOR"
                android:textColor="@color/bone_muted"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_consumables"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONSUMABLES"
                android:textColor="@color/bone_muted"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="10dp"/>

        <!-- Item list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/inventory_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

    </LinearLayout>

</LinearLayout>
