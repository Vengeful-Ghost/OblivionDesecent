<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_overlay"
    android:padding="@dimen/space_md">

    <!-- LEFT: Equipped Panel -->
    <LinearLayout
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_md">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipped"
                android:textAllCaps="true"
                android:textSize="@dimen/text_heading"
                android:textColor="@color/shadow_soft"
                android:shadowColor="@color/shadow_hard"
                android:gravity="center"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipped"
                android:textAllCaps="true"
                android:textSize="@dimen/text_heading"
                android:gravity="center"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <!-- Slots scroll instead of pushing Close off short screens -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Weapon slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_marginEnd="@dimen/space_md"
                        android:src="@drawable/ic_sword"
                        android:tint="@color/gold_bright"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OD.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WEAPON"
                            android:textColor="@color/border_gold"
                            tools:ignore="HardcodedText"/>

                        <TextView
                            android:id="@+id/txt_equipped_weapon"
                            style="@style/OD.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fists"
                            tools:ignore="HardcodedText"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Head slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_marginEnd="@dimen/space_md"
                        android:src="@drawable/ic_helmet"
                        android:tint="@color/gold_bright"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OD.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HEAD"
                            android:textColor="@color/border_gold"
                            tools:ignore="HardcodedText"/>

                        <TextView
                            android:id="@+id/txt_equipped_head"
                            style="@style/OD.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/bone_faint"
                            tools:ignore="HardcodedText"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Chest slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_marginEnd="@dimen/space_md"
                        android:src="@drawable/ic_chest_armor"
                        android:tint="@color/gold_bright"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OD.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHEST"
                            android:textColor="@color/border_gold"
                            tools:ignore="HardcodedText"/>

                        <TextView
                            android:id="@+id/txt_equipped_chest"
                            style="@style/OD.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/bone_faint"
                            tools:ignore="HardcodedText"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Legs slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_marginEnd="@dimen/space_md"
                        android:src="@drawable/ic_leg_armor"
                        android:tint="@color/gold_bright"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OD.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LEGS"
                            android:textColor="@color/border_gold"
                            tools:ignore="HardcodedText"/>

                        <TextView
                            android:id="@+id/txt_equipped_legs"
                            style="@style/OD.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/bone_faint"
                            tools:ignore="HardcodedText"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Boots slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_marginEnd="@dimen/space_md"
                        android:src="@drawable/ic_boots"
                        android:tint="@color/gold_bright"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OD.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BOOTS"
                            android:textColor="@color/border_gold"
                            tools:ignore="HardcodedText"/>

                        <TextView
                            android:id="@+id/txt_equipped_boots"
                            style="@style/OD.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/bone_faint"
                            tools:ignore="HardcodedText"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Close button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_inventory"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Close"
            android:textColor="@color/bone_dim"
            android:textSize="@dimen/text_small"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/bone_dim"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- RIGHT: Inventory Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="@dimen/space_lg">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textAllCaps="true"
                android:textSize="@dimen/text_heading"
                android:textColor="@color/shadow_soft"
                android:shadowColor="@color/shadow_hard"
                android:gravity="center"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textAllCaps="true"
                android:textSize="@dimen/text_heading"
                android:gravity="center"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Filter tabs: content-sized (Cinzel CONSUMABLES won't fit a quarter width) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                android:id="@+id/filter_all"
                style="@style/OD.Text.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="ALL"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/gold_bright"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_weapons"
                style="@style/OD.Text.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="WEAPONS"
                android:textSize="@dimen/text_caption"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_armor"
                style="@style/OD.Text.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="ARMOR"
                android:textSize="@dimen/text_caption"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/filter_consumables"
                style="@style/OD.Text.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="CONSUMABLES"
                android:textSize="@dimen/text_caption"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <!-- Item list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/inventory_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

    </LinearLayout>

</LinearLayout>
