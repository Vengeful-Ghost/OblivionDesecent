<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="20dp">

        <!-- Header: X + Name -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btn_close_detail"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:text="✕"
                android:textColor="#888888"
                android:textSize="18sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingHorizontal="36dp"
                android:text="Void Blade"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <!-- Type + Rarity badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/detail_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEAPON"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                tools:ignore="HardcodedText"/>

            <View android:layout_width="8dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/detail_rarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEGENDARY"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:background="@drawable/dialog_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            tools:ignore="HardcodedText"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="12dp"/>

        <!-- Stats -->
        <TextView
            android:id="@+id/detail_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="16dp"/>

        <!-- Price + Buy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/detail_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🪙 50"
                android:textColor="#FFD700"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_buy_detail"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Buy"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="28dp"
                app:cornerRadius="22dp"
                app:strokeWidth="2dp"
                app:strokeColor="#FFD700"
                app:backgroundTint="@color/darkGray"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>