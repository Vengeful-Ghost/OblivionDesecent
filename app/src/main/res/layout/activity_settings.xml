<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background">

    <!-- Particles -->
    <ImageView android:id="@+id/particle1" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="40dp" android:layout_marginStart="20dp"/>
    <ImageView android:id="@+id/particle2" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="80dp" android:layout_marginStart="120dp"/>
    <ImageView android:id="@+id/particle3" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="130dp" android:layout_marginStart="300dp"/>
    <ImageView android:id="@+id/particle4" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="60dp" android:layout_marginStart="220dp"/>
    <ImageView android:id="@+id/particle5" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="170dp" android:layout_marginStart="60dp"/>
    <ImageView android:id="@+id/particle6" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="200dp" android:layout_marginStart="350dp"/>
    <ImageView android:id="@+id/particle7" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="240dp" android:layout_marginStart="180dp"/>
    <ImageView android:id="@+id/particle8" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="280dp" android:layout_marginStart="90dp"/>
    <ImageView android:id="@+id/particle9" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="320dp" android:layout_marginStart="270dp"/>
    <ImageView android:id="@+id/particle10" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="360dp" android:layout_marginStart="40dp"/>
    <ImageView android:id="@+id/particle11" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="30dp" android:layout_marginStart="150dp"/>
    <ImageView android:id="@+id/particle12" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="80dp" android:layout_marginStart="310dp"/>
    <ImageView android:id="@+id/particle13" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="120dp" android:layout_marginStart="70dp"/>
    <ImageView android:id="@+id/particle14" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="160dp" android:layout_marginStart="230dp"/>
    <ImageView android:id="@+id/particle15" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="200dp" android:layout_marginStart="10dp"/>
    <ImageView android:id="@+id/particle16" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="240dp" android:layout_marginStart="380dp"/>
    <ImageView android:id="@+id/particle17" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="280dp" android:layout_marginStart="120dp"/>
    <ImageView android:id="@+id/particle18" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="320dp" android:layout_marginStart="260dp"/>
    <ImageView android:id="@+id/particle19" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="50dp" android:layout_marginEnd="80dp"/>
    <ImageView android:id="@+id/particle20" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="150dp" android:layout_marginEnd="200dp"/>
    <ImageView android:id="@+id/particle21" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="250dp" android:layout_marginEnd="50dp"/>
    <ImageView android:id="@+id/particle22" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="60dp" android:layout_marginEnd="160dp"/>
    <ImageView android:id="@+id/particle23" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="160dp" android:layout_marginEnd="90dp"/>
    <ImageView android:id="@+id/particle24" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="260dp" android:layout_marginEnd="30dp"/>
    <ImageView android:id="@+id/particle25" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="100dp" android:layout_marginStart="450dp"/>
    <ImageView android:id="@+id/particle26" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="300dp" android:layout_marginStart="500dp"/>
    <ImageView android:id="@+id/particle27" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="100dp" android:layout_marginStart="420dp"/>
    <ImageView android:id="@+id/particle28" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="180dp" android:layout_marginStart="550dp"/>
    <ImageView android:id="@+id/particle29" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginBottom="180dp" android:layout_marginStart="480dp"/>
    <ImageView android:id="@+id/particle30" android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/particle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="350dp" android:layout_marginStart="600dp"/>

    <!-- Vignette -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_overlay"
        android:alpha="0.92"
        android:animation="@anim/slow_pulse"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Settings card: three columns, so everything fits without scrolling -->
    <LinearLayout
        android:id="@+id/settingsCard"
        style="@style/OD.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/space_xl"
        app:layout_constraintWidth_max="760dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/OD.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textAllCaps="true"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="@color/gold_glow"
            android:shadowRadius="18"
            android:animation="@anim/glow_pulse"
            tools:ignore="HardcodedText"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_md"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- FEEDBACK -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/OD.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FEEDBACK"
                    android:textColor="@color/gold_bright"
                    android:letterSpacing="0.24"
                    android:layout_marginBottom="@dimen/space_sm"
                    tools:ignore="HardcodedText"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vibration"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:drawableStart="@drawable/ic_vibration"
                        android:drawablePadding="@dimen/space_sm"
                        tools:ignore="HardcodedText"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_vibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:checked="true"
                        app:thumbTint="@color/gold_bright"
                        app:trackTint="@color/border_gold_outer"/>

                </LinearLayout>

                <TextView
                    style="@style/OD.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone vibrates when you take damage"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="italic"
                    tools:ignore="HardcodedText"/>

                <!-- OEM warning, shown while vibration is on -->
                <TextView
                    android:id="@+id/txt_miui_warning"
                    style="@style/OD.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Battery savers can block vibration. If it doesn't work, check this app's permissions."
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/warning_amber"
                    android:textStyle="italic"
                    android:drawableStart="@drawable/ic_warning"
                    android:drawablePadding="@dimen/space_xs"
                    android:visibility="gone"
                    tools:ignore="HardcodedText"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:background="@color/divider_gold"/>

            <!-- AUDIO: label and slider share a row -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <TextView
                    style="@style/OD.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUDIO"
                    android:textColor="@color/gold_bright"
                    android:letterSpacing="0.24"
                    android:layout_marginBottom="@dimen/space_sm"
                    tools:ignore="HardcodedText"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Effects"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:drawableStart="@drawable/ic_volume"
                        android:drawablePadding="@dimen/space_sm"
                        tools:ignore="HardcodedText"/>

                    <SeekBar
                        android:id="@+id/seekbar_sfx_volume"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1.3"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/gold_bright"
                        android:thumbTint="@color/gold_bright"
                        android:progressBackgroundTint="@color/border_gold_outer"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Menu music"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:drawableStart="@drawable/ic_music"
                        android:drawablePadding="@dimen/space_sm"
                        tools:ignore="HardcodedText"/>

                    <SeekBar
                        android:id="@+id/seekbar_menu_music_volume"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1.3"
                        android:max="100"
                        android:progress="85"
                        android:progressTint="@color/gold_bright"
                        android:thumbTint="@color/gold_bright"
                        android:progressBackgroundTint="@color/border_gold_outer"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/OD.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Game music"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:drawableStart="@drawable/ic_music"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableTint="@color/crimson_glow"
                        tools:ignore="HardcodedText"/>

                    <SeekBar
                        android:id="@+id/seekbar_game_music_volume"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1.3"
                        android:max="100"
                        android:progress="85"
                        android:progressTint="@color/gold_bright"
                        android:thumbTint="@color/gold_bright"
                        android:progressBackgroundTint="@color/border_gold_outer"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:background="@color/divider_gold"/>

            <!-- ACCOUNT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/OD.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT"
                    android:textColor="@color/gold_bright"
                    android:letterSpacing="0.24"
                    android:layout_marginBottom="@dimen/space_sm"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sign_out"
                    style="@style/OD.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:text="Sign Out"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_back"
                    style="@style/OD.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="Back"
                    app:icon="@drawable/ic_back"
                    android:stateListAnimator="@animator/button_elevation_anim"
                    android:translationZ="6dp"
                    tools:ignore="HardcodedText"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/OD.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="Icons by Lorc, Delapouite and Skoll · game-icons.net · CC BY 3.0&#10;Fonts: Cinzel, Crimson Pro · SIL Open Font License 1.1"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/bone_muted"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>