<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deepest"
    tools:context=".GameActivity">

    <FrameLayout
        android:id="@+id/game_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_base">

        <com.example.obliviondescent.GameDisplay
            android:id="@+id/game_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- HUD layer: padded at runtime by the camera-cutout insets -->
    <RelativeLayout
        android:id="@+id/hud_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/top_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:backgroundTint="@null"
            android:background="@drawable/icon_btn_circle"
            app:icon="@drawable/menu_btn"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/gold_bright"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_sm"
            android:background="@drawable/hud_panel"
            android:layout_marginStart="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/healthBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/health_bar" />

                <TextView
                    android:id="@+id/txt_health_value"
                    style="@style/OD.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="100 / 100"
                    android:textColor="@color/crimson_glow"
                    android:textSize="@dimen/text_caption"
                    android:shadowDx="0" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/space_sm">

                <ProgressBar
                    android:id="@+id/armorBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="1"
                    android:progressDrawable="@drawable/armor_bar" />

                <TextView
                    android:id="@+id/txt_armor_value"
                    style="@style/OD.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="0 / 0"
                    android:textColor="@color/armor_blue"
                    android:textSize="@dimen/text_caption"
                    android:shadowDx="0" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_inventory"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/space_md"
            app:backgroundTint="@null"
            android:background="@drawable/icon_btn_circle"
            app:icon="@drawable/bag_btn"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/gold_bright"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="0dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_md"
            android:padding="@dimen/space_sm"
            android:background="@drawable/hud_panel"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txt_floor_number"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Floor 1"
                android:textColor="@color/bone_white"
                android:textSize="@dimen/text_caption"
                android:letterSpacing="0.06"
                android:shadowDx="0"/>

            <TextView
                android:id="@+id/txt_kill_progress"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 8"
                android:textColor="@color/crimson_glow"
                android:textSize="@dimen/text_caption"
                android:shadowDx="0"/>

            <TextView
                android:id="@+id/txt_gold"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="0"
                android:textSize="@dimen/text_caption"
                android:drawableStart="@drawable/ic_coin"
                android:drawablePadding="@dimen/space_xs"
                android:drawableTint="@color/gold_bright"
                android:shadowDx="0"/>

            <TextView
                android:id="@+id/txt_level"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lv 1  •  0/20 XP"
                android:textColor="@color/gold_glow"
                android:textSize="@dimen/text_caption"
                android:shadowDx="0"/>

        </LinearLayout>


    </LinearLayout>

    <com.example.obliviondescent.JoystickView
        android:id="@+id/joystick"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="32dp"/>

    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="40dp">

        <!-- Quick-heal potion with a count badge -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_potion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@null"
                android:background="@drawable/icon_btn_circle"
                android:contentDescription="Quick heal"
                app:icon="@drawable/ic_heart"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="@dimen/icon_lg"
                app:iconTint="@color/health_red"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"/>

            <TextView
                android:id="@+id/txt_potion_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                style="@style/OD.Text.Value"
                android:minWidth="20dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_xs"
                android:background="@drawable/hud_panel"
                android:text="0"
                android:textColor="@color/bone_white"
                android:textSize="@dimen/text_caption"
                android:translationZ="10dp"/>

        </FrameLayout>

        <!-- Dash button wrapped in FrameLayout for cooldown arc overlay -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@null"
                android:background="@drawable/icon_btn_circle"
                android:padding="0dp"
                android:text="D"
                android:textSize="20sp"
                android:textColor="@color/gold_bright"
                android:fontFamily="@font/cinzel"
                android:textStyle="bold"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"/>

            <com.example.obliviondescent.DashCooldownView
                android:id="@+id/dash_cooldown_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationZ="10dp"/>

        </FrameLayout>

        <!-- Spin special with cooldown arc -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="60dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@null"
                android:background="@drawable/icon_btn_circle"
                android:padding="0dp"
                android:text="SPIN"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/gold_bright"
                android:fontFamily="@font/cinzel"
                android:textStyle="bold"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"/>

            <com.example.obliviondescent.DashCooldownView
                android:id="@+id/spin_cooldown_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationZ="10dp"/>

        </FrameLayout>

        <!-- Attack button — hidden, replaced by aim joystick -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_attack"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cornerRadius="48dp"
            android:backgroundTint="@color/crimson_base"
            android:text="ATK"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/bone_white"
            android:fontFamily="@font/cinzel"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/crimson_glow"
            android:visibility="gone"/>

        <!-- Attack stick — hold to attack, drag to aim -->
        <com.example.obliviondescent.AimJoystickView
            android:id="@+id/aim_joystick"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:visibility="gone"/>

    </LinearLayout>

    </RelativeLayout>

    <!-- Floor transition overlay -->
    <FrameLayout
        android:id="@+id/floor_transition_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_deepest"
        android:visibility="gone"
        android:clickable="true"
        android:gravity="center">

        <TextView
            android:id="@+id/txt_floor_title"
            style="@style/OD.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:text="Floor 1"
            android:textSize="56sp"
            android:letterSpacing="0.16"
            android:shadowColor="@color/gold_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"
            android:alpha="0"/>

    </FrameLayout>

    <!-- Boss intro: a title card across the middle; play continues underneath -->
    <FrameLayout
        android:id="@+id/boss_intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/boss_band"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="24dp">

            <TextView
                android:id="@+id/boss_label"
                style="@style/OD.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUARDIAN"
                android:textColor="@color/crimson_glow"
                android:letterSpacing="0.5"
                android:shadowColor="@color/ink_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                tools:ignore="HardcodedText"/>

            <View
                android:id="@+id/boss_line_top"
                android:layout_width="360dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/divider_gold"/>

            <!-- Shrinks long AI-generated names to fit on one line -->
            <TextView
                android:id="@+id/boss_name"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="48dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/gold_bright"
                android:textStyle="bold"
                android:fontFamily="@font/cinzel"
                android:letterSpacing="0.12"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="22sp"
                app:autoSizeMaxTextSize="46sp"
                app:autoSizeStepGranularity="2sp"/>

            <View
                android:id="@+id/boss_line_bottom"
                android:layout_width="360dp"
                android:layout_height="1dp"
                android:background="@drawable/divider_gold"/>

            <TextView
                android:id="@+id/boss_title"
                style="@style/OD.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:textStyle="italic"
                android:letterSpacing="0.08"
                android:shadowColor="@color/ink_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"/>

        </LinearLayout>

    </FrameLayout>

</RelativeLayout>