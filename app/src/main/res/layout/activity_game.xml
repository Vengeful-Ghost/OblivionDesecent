<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deepest"
    tools:context=".GameActivity">

    <FrameLayout
        android:id="@+id/game_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_base">

        <com.example.obliviondescent.GameDisplay
            android:id="@+id/game_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- HUD layer: padded at runtime by the camera-cutout insets -->
    <RelativeLayout
        android:id="@+id/hud_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Top-left: menu + vitals -->
    <LinearLayout
        android:id="@+id/top_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            app:backgroundTint="@null"
            android:background="@drawable/icon_btn_circle"
            app:icon="@drawable/menu_btn"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/gold_bright"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="184dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_sm"
            android:background="@drawable/hud_panel"
            android:tag="stone"
            android:layout_marginStart="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/healthBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/health_bar" />

                <TextView
                    android:id="@+id/txt_health_value"
                    style="@style/OD.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="100 / 100"
                    android:textColor="@color/crimson_glow"
                    android:textSize="@dimen/text_caption"
                    android:shadowDx="0" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/space_sm">

                <ProgressBar
                    android:id="@+id/armorBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="1"
                    android:progressDrawable="@drawable/armor_bar" />

                <TextView
                    android:id="@+id/txt_armor_value"
                    style="@style/OD.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="0 / 0"
                    android:textColor="@color/armor_blue"
                    android:textSize="@dimen/text_caption"
                    android:shadowDx="0" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_level"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Lv 1  •  0/20 XP"
                android:textColor="@color/gold_glow"
                android:textSize="@dimen/text_caption"
                android:shadowDx="0"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Top-centre: floor and kill progress -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_sm"
        android:background="@drawable/hud_panel"
        android:tag="stone"
        android:gravity="center_horizontal"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/space_md">

        <TextView
            android:id="@+id/txt_floor_number"
            style="@style/OD.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floor 1"
            android:textColor="@color/bone_white"
            android:textSize="@dimen/text_caption"
            android:letterSpacing="0.06"
            android:shadowDx="0"/>

        <TextView
            android:id="@+id/txt_kill_progress"
            style="@style/OD.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 8"
            android:textColor="@color/crimson_glow"
            android:textSize="@dimen/text_caption"
            android:shadowDx="0"/>

    </LinearLayout>

    <!-- Bag + gold, left of the canvas minimap (top-right 140dp is reserved) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="140dp">

        <!-- The bag, with a gold pip counting unspent stat points (spent in the bag's Stats tab) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_inventory"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            app:backgroundTint="@null"
            android:background="@drawable/icon_btn_circle"
            app:icon="@drawable/bag_btn"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/gold_bright"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="0dp"/>

            <TextView
                android:id="@+id/txt_bag_points"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-6dp"
                android:minWidth="18dp"
                android:gravity="center"
                android:paddingHorizontal="3dp"
                android:background="@color/gold_bright"
                android:text="3"
                android:textColor="@color/bg_deepest"
                android:textSize="11sp"
                android:shadowRadius="0"
                android:translationZ="10dp"
                android:visibility="gone"
                android:importantForAccessibility="no"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <TextView
            android:id="@+id/txt_gold"
            style="@style/OD.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/hud_panel"
            android:tag="stone"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:gravity="center_vertical"
            android:text="0"
            android:textSize="@dimen/text_caption"
            android:drawableLeft="@drawable/ic_coin_px"
            android:drawablePadding="@dimen/space_xs"
            android:shadowDx="0"/>

        <!-- Keys open vault gates; shown once you hold one -->
        <TextView
            android:id="@+id/txt_keys"
            style="@style/OD.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/hud_panel"
            android:tag="stone"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:gravity="center_vertical"
            android:text="0"
            android:textSize="@dimen/text_caption"
            android:drawableStart="@drawable/ic_key"
            android:drawablePadding="@dimen/space_xs"
            android:drawableTint="@color/gold_bright"
            android:shadowDx="0"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- First-run tutorial: one step at a time; tap it to skip -->
    <TextView
        android:id="@+id/txt_tutorial"
        style="@style/OD.Text.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/space_lg"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm"
        android:background="@drawable/hud_panel"
        android:tag="stone"
        android:gravity="center"
        android:textSize="@dimen/text_small"
        android:textColor="@color/gold_bright"
        android:visibility="gone"/>

    <com.example.obliviondescent.JoystickView
        android:id="@+id/joystick"
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="@dimen/space_lg"
        android:layout_marginStart="@dimen/space_xl"/>

    <!-- Attack stick with dash, heavy, spin and potion on an arc ~100dp from its centre -->
    <FrameLayout
        android:id="@+id/action_buttons"
        android:layout_width="188dp"
        android:layout_height="184dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="@dimen/space_lg"
        android:layout_marginEnd="20dp">

        <!-- Attack stick — hold to attack, drag to aim -->
        <com.example.obliviondescent.AimJoystickView
            android:id="@+id/aim_joystick"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|end"
            android:visibility="gone"/>

        <!-- Dash button wrapped in FrameLayout for cooldown arc overlay -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="132dp"
            android:layout_marginBottom="@dimen/space_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@null"
                android:background="@drawable/icon_btn_circle"
                android:padding="0dp"
                android:text="DASH"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/gold_bright"
                android:fontFamily="@font/pixel"
                android:textStyle="bold"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"/>

            <com.example.obliviondescent.DashCooldownView
                android:id="@+id/dash_cooldown_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationZ="10dp"/>

        </FrameLayout>

        <!-- Heavy attack: hold to charge, release to strike; breaks guards -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="125dp"
            android:layout_marginBottom="70dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_heavy"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@null"
                android:background="@drawable/icon_btn_circle"
                android:contentDescription="Heavy attack"
                app:icon="@drawable/ic_anvil"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="@dimen/icon_lg"
                app:iconTint="@color/gold_bright"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"
                tools:ignore="HardcodedText"/>

            <com.example.obliviondescent.DashCooldownView
                android:id="@+id/heavy_cooldown_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationZ="10dp"/>

        </FrameLayout>

        <!-- Spin special with cooldown arc -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="88dp"
            android:layout_marginBottom="115dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@null"
                android:background="@drawable/icon_btn_circle"
                android:padding="0dp"
                android:text="SPIN"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/gold_bright"
                android:fontFamily="@font/pixel"
                android:textStyle="bold"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"/>

            <com.example.obliviondescent.DashCooldownView
                android:id="@+id/spin_cooldown_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationZ="10dp"/>

        </FrameLayout>

        <!-- Quick-heal potion with a count badge -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="34dp"
            android:layout_marginBottom="132dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_potion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@null"
                android:background="@drawable/icon_btn_circle"
                android:contentDescription="Quick heal"
                app:icon="@drawable/ic_heart"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="@dimen/icon_lg"
                app:iconTint="@color/health_red"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"/>

            <com.example.obliviondescent.DashCooldownView
                android:id="@+id/potion_cooldown_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationZ="10dp"/>

            <TextView
                android:id="@+id/txt_potion_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                style="@style/OD.Text.Value"
                android:minWidth="20dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_xs"
                android:background="@drawable/hud_panel"
                android:tag="stone"
                android:text="0"
                android:textColor="@color/bone_white"
                android:textSize="@dimen/text_caption"
                android:translationZ="10dp"/>

        </FrameLayout>

    </FrameLayout>

    </RelativeLayout>

    <!-- Floor transition overlay -->
    <FrameLayout
        android:id="@+id/floor_transition_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_deepest"
        android:visibility="gone"
        android:clickable="true"
        android:gravity="center">

        <TextView
            android:id="@+id/txt_floor_title"
            style="@style/OD.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:text="Floor 1"
            android:textSize="56sp"
            android:letterSpacing="0.16"
            android:shadowColor="@color/gold_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"
            android:alpha="0"/>

    </FrameLayout>

    <!-- Boss intro: a title card across the middle; play continues underneath -->
    <FrameLayout
        android:id="@+id/boss_intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/boss_band"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="24dp">

            <TextView
                android:id="@+id/boss_label"
                style="@style/OD.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUARDIAN"
                android:textColor="@color/crimson_glow"
                android:letterSpacing="0.5"
                android:shadowColor="@color/ink_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                tools:ignore="HardcodedText"/>

            <View
                android:id="@+id/boss_line_top"
                android:layout_width="360dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/divider_gold"/>

            <!-- Shrinks long AI-generated names to fit on one line -->
            <TextView
                android:id="@+id/boss_name"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="48dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/gold_bright"
                android:textStyle="bold"
                android:fontFamily="@font/pixel"
                android:letterSpacing="0.12"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="22sp"
                app:autoSizeMaxTextSize="46sp"
                app:autoSizeStepGranularity="2sp"/>

            <View
                android:id="@+id/boss_line_bottom"
                android:layout_width="360dp"
                android:layout_height="1dp"
                android:background="@drawable/divider_gold"/>

            <TextView
                android:id="@+id/boss_title"
                style="@style/OD.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:textStyle="italic"
                android:letterSpacing="0.08"
                android:shadowColor="@color/ink_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"/>

        </LinearLayout>

    </FrameLayout>

</RelativeLayout>