<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/space_xxl"
    android:background="@drawable/rounded_dialog_bg">

    <ProgressBar
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/gold_bright"
        android:layout_marginBottom="@dimen/space_lg"/>

    <TextView
        android:id="@+id/txt_loading_message"
        style="@style/OD.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textColor="@color/gold_glow"
        android:textStyle="italic"
        android:letterSpacing="0.08"
        android:gravity="center"/>

</LinearLayout>
