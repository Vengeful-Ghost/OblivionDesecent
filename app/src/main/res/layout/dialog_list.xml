<?xml version="1.0" encoding="utf-8"?>
<!-- A titled list card: daily quests and run history -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/space_md">

    <!-- Only scrolls if the card is taller than the screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        style="@style/OD.Card"
        android:layout_width="@dimen/card_width_lg"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:animation="@anim/dialog_open">

        <!-- Header: close, title, note -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs">

            <ImageButton
                android:id="@+id/btn_close_list"
                style="@style/OD.CloseButton"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="Close"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/txt_list_title"
                style="@style/OD.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="@dimen/text_heading"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                tools:text="DAILY QUESTS"/>

            <TextView
                android:id="@+id/txt_list_note"
                style="@style/OD.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/space_sm"
                android:textColor="@color/bone_muted"
                tools:text="Resets at 00:00 UTC"/>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <LinearLayout
            android:id="@+id/list_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

    </FrameLayout>

    </ScrollView>

</FrameLayout>
