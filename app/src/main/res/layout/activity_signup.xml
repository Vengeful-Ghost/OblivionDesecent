        android:hint="Confirm password"
        app:endIconMode="password_toggle"
        app:endIconTint="#FFD700"
        android:background="@drawable/input_bg"
        android:alpha="0.96"
        app:boxBackgroundMode="none"
        app:boxStrokeColor="#FFD700"
        app:hintTextColor="#FFD700"
        app:boxStrokeWidth="2dp"
        app:boxStrokeWidthFocused="3dp"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintTop_toBottomOf="@+id/signupPasswordLayout"
        app:layout_constraintBottom_toTopOf="@+id/btnSignup"
        app:layout_constraintStart_toStartOf="@+id/signupUsernameLayout"
        app:layout_constraintEnd_toEndOf="@+id/signupUsernameLayout"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSignupConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textColorHint="#777777"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSignup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="10"
        android:shadowRadius="3"
        app:backgroundTint="@null"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="8dp"
        app:layout_constraintTop_toBottomOf="@+id/signupConfirmLayout"
        app:layout_constraintBottom_toTopOf="@+id/tvBackToLogin"
        app:layout_constraintStart_toStartOf="@+id/signupUsernameLayout"
        app:layout_constraintEnd_toEndOf="@+id/signupUsernameLayout"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        tools:ignore="HardcodedText"
        android:background="@drawable/btn_login"/>

