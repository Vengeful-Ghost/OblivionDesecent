<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="11dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/dialog_bg">

    <!-- Rank number -->
    <TextView
        android:id="@+id/lb_rank"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="#1"
        android:textColor="@color/gold_bright"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.04"
        android:gravity="center"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"/>

    <!-- Name + subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/lb_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="@color/bone_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/lb_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floor 1 • 0 kills"
            android:textColor="@color/bone_muted"
            android:textSize="11sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- Highest floor badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/lb_highest_floor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/gold_bright"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:shadowColor="@color/gold_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOOR"
            android:textColor="@color/bone_muted"
            android:textSize="9sp"
            android:fontFamily="serif"
            android:letterSpacing="0.2"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>
