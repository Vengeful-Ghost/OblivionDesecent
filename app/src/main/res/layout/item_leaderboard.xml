<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/dialog_bg">

    <!-- Rank number -->
    <TextView
        android:id="@+id/lb_rank"
        style="@style/OD.Text.Value"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="#1"
        android:gravity="center"/>

    <!-- Name + subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/space_md">

        <TextView
            android:id="@+id/lb_username"
            style="@style/OD.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/lb_subtitle"
            style="@style/OD.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floor 1 • 0 kills"
            android:textColor="@color/bone_muted"
            android:textSize="@dimen/text_caption"
            android:textStyle="italic"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- Highest floor badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/lb_highest_floor"
            style="@style/OD.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="@dimen/text_heading"
            android:gravity="center"/>

        <TextView
            style="@style/OD.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOOR"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>
