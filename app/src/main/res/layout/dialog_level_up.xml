<?xml version="1.0" encoding="utf-8"?>
<!-- Level-up perk choice: three cards grow in face down, flip one by one, then wait for a pick -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/txt_perk_title"
            style="@style/OD.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 2"
            android:textAllCaps="true"
            android:shadowColor="@color/gold_glow"
            android:shadowRadius="18"
            tools:ignore="HardcodedText"/>

        <TextView
            style="@style/OD.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a blessing"
            android:textStyle="italic"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- Cards share the width; row padding + card margins give equal gaps everywhere -->
    <LinearLayout
        android:id="@+id/perk_cards"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md"/>

</FrameLayout>
