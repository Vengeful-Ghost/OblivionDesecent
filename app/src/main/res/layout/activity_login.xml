    <View
        android:id="@+id/vignetteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_overlay"
        android:alpha="0.92"
        android:animation="@anim/slow_pulse" />

    <TextView
        android:id="@+id/GameTitleFront"
        style="@style/OD.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Oblivion Descent"
        android:textAllCaps="true"
        android:textSize="52sp"
        android:maxLines="2"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeMaxTextSize="52sp"
        app:autoSizeStepGranularity="1sp"
        android:gravity="center"
        android:shadowColor="@color/gold_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="18"
        android:animation="@anim/glow_pulse"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/usernameLayout"
        android:layout_marginEnd="@dimen/space_xxl"
        tools:ignore="HardcodedText" />



    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/usernameLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Username"
        app:boxStrokeColor="@color/gold_bright"
        app:hintTextColor="@color/gold_glow"
        app:boxBackgroundMode="none"
        app:boxStrokeWidth="2dp"
        app:boxStrokeWidthFocused="3dp"
        android:alpha="0.98"
        android:background="@drawable/input_bg"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintBottom_toTopOf="@+id/passwordLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="@dimen/space_md"
        tools:ignore="HardcodedText">

        <!-- frame is drawn by the TextInputLayout (Java swaps its focus background) -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/Username"
            style="@style/OD.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:inputType="textPersonName" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Password"
        app:boxStrokeColor="@color/gold_bright"
        app:hintTextColor="@color/gold_glow"
        app:boxBackgroundMode="none"
        app:boxStrokeWidth="2dp"
        app:boxStrokeWidthFocused="3dp"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/gold_bright"
        android:alpha="0.98"
        android:background="@drawable/input_bg"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintTop_toBottomOf="@id/usernameLayout"
        app:layout_constraintBottom_toTopOf="@+id/checkRememberMe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/usernameLayout"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="@dimen/space_sm"
        tools:ignore="HardcodedText">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/Password"
            style="@style/OD.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:inputType="textPassword" />

    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/checkRememberMe"
        style="@style/OD.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember me"
        android:textColor="@color/bone_dim"
        android:buttonTint="@color/gold_base"
        android:alpha="0.95"
        app:layout_constraintTop_toBottomOf="@id/passwordLayout"
        app:layout_constraintBottom_toTopOf="@+id/btnLogin"
        app:layout_constraintStart_toStartOf="@+id/passwordLayout"
        android:layout_marginBottom="@dimen/space_lg" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        style="@style/OD.Button"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:text="Login"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@id/checkRememberMe"
        app:layout_constraintBottom_toTopOf="@+id/SignUp"
        app:layout_constraintStart_toStartOf="@+id/passwordLayout"
        app:layout_constraintEnd_toEndOf="@+id/passwordLayout"
        android:layout_marginBottom="@dimen/space_xs"
        android:clickable="true"
        android:focusable="true"
        tools:ignore="HardcodedText" />


    <TextView
        android:id="@+id/SignUp"
        style="@style/OD.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:text="Don't have an account? Sign up"
        android:textColor="@color/gold_glow"
        android:gravity="center"
        android:textStyle="italic"
        android:alpha="0.92"
        android:letterSpacing="0.04"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:animation="@anim/fade_in_delayed"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btnLogin"
        app:layout_constraintEnd_toEndOf="@+id/btnLogin"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>