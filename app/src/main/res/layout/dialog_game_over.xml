<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/space_lg">

    <!-- Only scrolls if the card is taller than the screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Three columns, so the card fits short landscape screens without scrolling -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_xl"
        android:background="@drawable/rounded_dialog_bg"
        android:tag="stone"
        android:layout_gravity="center"
        android:animation="@anim/dialog_open">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_skull"
            android:tint="@color/crimson_glow"
            android:importantForAccessibility="no"
            android:layout_marginBottom="@dimen/space_sm"/>

        <TextView
            android:id="@+id/txt_over_title"
            style="@style/OD.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textColor="@color/crimson_glow"
            android:letterSpacing="0.18"
            android:shadowColor="@color/crimson_base"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txt_over_message"
            style="@style/OD.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have fallen into the Oblivion..."
            android:textColor="@color/bone_dim"
            android:textStyle="italic"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_lg"/>

        <TextView
            android:id="@+id/txt_checkpoint"
            style="@style/OD.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last checkpoint: Floor 1"
            android:textColor="@color/gold_glow"
            android:drawableStart="@drawable/ic_flag"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="@color/gold_glow"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txt_souls"
            style="@style/OD.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="+0 Souls"
            android:textColor="@color/arcane_glow"
            android:drawableStart="@drawable/ic_level"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="@color/arcane_glow"
            android:gravity="center"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:background="@color/divider_gold"/>

    <!-- Run summary: stat cards, two per row, added in Java -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:orientation="vertical">

        <TextView
            style="@style/OD.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="RUN SUMMARY"
            android:textColor="@color/gold_bright"/>

        <LinearLayout
            android:id="@+id/summary_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:background="@color/divider_gold"/>

    <LinearLayout
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Opt-in rewarded ads; shown only when an ad is loaded -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ad_revive"
            style="@style/OD.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="Revive here (ad)"
            android:textSize="@dimen/text_small"
            android:layout_marginBottom="@dimen/space_md"
            android:visibility="gone"
            tools:ignore="HardcodedText"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_respawn"
            style="@style/OD.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="RESPAWN"
            android:textColor="@color/bone_white"
            android:layout_marginBottom="@dimen/space_md"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_game_over_menu"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="MAIN MENU"
            android:textSize="@dimen/text_small"
            android:textColor="@color/bone_dim"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ad_souls"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_md"
            android:text="x2 Souls (ad)"
            android:textSize="@dimen/text_small"
            android:textColor="@color/arcane_glow"
            android:visibility="gone"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    </LinearLayout>

    </FrameLayout>

    </ScrollView>

</FrameLayout>
