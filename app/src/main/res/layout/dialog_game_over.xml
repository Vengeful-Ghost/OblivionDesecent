<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/space_lg">

    <!-- Scrolls instead of clipping on short landscape screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/card_width_sm"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:background="@drawable/rounded_dialog_bg"
        android:layout_gravity="center"
        android:animation="@anim/dialog_open">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_skull"
            android:tint="@color/crimson_glow"
            android:importantForAccessibility="no"
            android:layout_marginBottom="@dimen/space_sm"/>

        <TextView
            style="@style/OD.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textColor="@color/crimson_glow"
            android:letterSpacing="0.18"
            android:shadowColor="@color/crimson_base"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center"/>

        <TextView
            style="@style/OD.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have fallen into the Oblivion..."
            android:textColor="@color/bone_dim"
            android:textStyle="italic"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_lg"/>

        <TextView
            android:id="@+id/txt_checkpoint"
            style="@style/OD.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last checkpoint: Floor 1"
            android:textColor="@color/gold_glow"
            android:drawableStart="@drawable/ic_flag"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="@color/gold_glow"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_xl"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_respawn"
            style="@style/OD.Button.Danger"
            android:layout_width="220dp"
            android:layout_height="@dimen/button_height"
            android:text="RESPAWN"
            android:textColor="@color/bone_white"
            android:layout_marginBottom="@dimen/space_md"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_game_over_menu"
            style="@style/OD.Button.Secondary"
            android:layout_width="220dp"
            android:layout_height="@dimen/touch_min"
            android:text="MAIN MENU"
            android:textSize="@dimen/text_small"
            android:textColor="@color/bone_dim"/>

    </LinearLayout>

    </FrameLayout>

    </ScrollView>

</FrameLayout>
