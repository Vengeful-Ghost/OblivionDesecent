<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/rounded_dialog_bg"
    android:layout_gravity="center"
    android:animation="@anim/dialog_open">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💀"
        android:textSize="56sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GAME OVER"
        android:textColor="@color/crimson_glow"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.18"
        android:shadowColor="@color/crimson_base"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="14"
        android:layout_marginBottom="6dp"
        android:gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You have fallen into the Oblivion..."
        android:textColor="@color/bone_dim"
        android:textSize="13sp"
        android:textStyle="italic"
        android:fontFamily="serif"
        android:letterSpacing="0.06"
        android:gravity="center"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:id="@+id/txt_checkpoint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏁  Last checkpoint: Floor 1"
        android:textColor="@color/gold_glow"
        android:textSize="13sp"
        android:fontFamily="serif"
        android:gravity="center"
        android:layout_marginBottom="22dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_respawn"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:text="RESPAWN"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.12"
        android:textColor="@color/bone_white"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@null"
        android:background="@drawable/btn_gothic_danger"
        android:layout_marginBottom="10dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_game_over_menu"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:text="MAIN MENU"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.06"
        android:textColor="@color/bone_dim"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@null"
        android:background="@drawable/btn_gothic_secondary"/>

</LinearLayout>
