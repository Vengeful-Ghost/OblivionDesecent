<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_overlay"
        android:alpha="0.94"
        android:animation="@anim/slow_pulse"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- LEFT: Title -->
    <FrameLayout
        android:id="@+id/titleBlock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/slotsCard"
        android:layout_marginEnd="32dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Start Game"
            android:textAllCaps="true"
            android:textSize="44sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#66000000"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:shadowColor="#CC000000"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="10"
            android:translationX="-5dp"
            android:translationY="5dp"
            tools:ignore="HardcodedText"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Start Game"
            android:textAllCaps="true"
            android:textSize="44sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/gold_bright"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:shadowColor="@color/gold_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="18"
            android:animation="@anim/glow_pulse"
            tools:ignore="HardcodedText"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            android:layout_width="200dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:text="← Main Menu"
            android:textAllCaps="false"
            android:textColor="@color/gold_glow"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_gothic_secondary"
            tools:ignore="HardcodedText"/>

    </FrameLayout>

    <!-- RIGHT: Slots card -->
    <LinearLayout
        android:id="@+id/slotsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="18dp"
        app:layout_constraintWidth_percent="0.52"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <!-- SLOT 1 -->
        <RelativeLayout
            android:id="@+id/slot1_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/slot1_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentTop="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLOT 1"
                    android:textColor="@color/gold_bright"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.28"
                    android:layout_marginBottom="6dp"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/slot1_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Empty"
                    android:textColor="@color/bone_muted"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:fontFamily="serif"/>

                <TextView
                    android:id="@+id/slot1_info2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/bone_dim"
                    android:textSize="12sp"
                    android:fontFamily="serif"
                    android:visibility="gone"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot1_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_alignParentBottom="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot1_btn_load"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Load"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:visibility="gone"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_gothic_secondary"
                    android:layout_marginEnd="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot1_btn_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/crimson_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:visibility="gone"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_gothic_danger"
                    android:layout_marginEnd="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot1_btn_new"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="New Game"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_login"
                    tools:ignore="HardcodedText"/>

            </LinearLayout>
        </RelativeLayout>

        <!-- SLOT 2 -->
        <RelativeLayout
            android:id="@+id/slot2_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/slot2_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentTop="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLOT 2"
                    android:textColor="@color/gold_bright"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.28"
                    android:layout_marginBottom="6dp"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/slot2_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Empty"
                    android:textColor="@color/bone_muted"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:fontFamily="serif"/>

                <TextView
                    android:id="@+id/slot2_info2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/bone_dim"
                    android:textSize="12sp"
                    android:fontFamily="serif"
                    android:visibility="gone"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot2_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_alignParentBottom="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot2_btn_load"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Load"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:visibility="gone"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_gothic_secondary"
                    android:layout_marginEnd="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot2_btn_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/crimson_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:visibility="gone"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_gothic_danger"
                    android:layout_marginEnd="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot2_btn_new"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="New Game"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_login"
                    tools:ignore="HardcodedText"/>

            </LinearLayout>
        </RelativeLayout>

        <!-- SLOT 3 -->
        <RelativeLayout
            android:id="@+id/slot3_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_bg"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/slot3_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentTop="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLOT 3"
                    android:textColor="@color/gold_bright"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.28"
                    android:layout_marginBottom="6dp"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/slot3_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Empty"
                    android:textColor="@color/bone_muted"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:fontFamily="serif"/>

                <TextView
                    android:id="@+id/slot3_info2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/bone_dim"
                    android:textSize="12sp"
                    android:fontFamily="serif"
                    android:visibility="gone"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot3_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_alignParentBottom="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot3_btn_load"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Load"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:visibility="gone"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_gothic_secondary"
                    android:layout_marginEnd="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot3_btn_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/crimson_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:visibility="gone"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_gothic_danger"
                    android:layout_marginEnd="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slot3_btn_new"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="New Game"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_glow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/btn_login"
                    tools:ignore="HardcodedText"/>

            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
