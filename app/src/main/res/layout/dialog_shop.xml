<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Particle background -->
    <com.example.obliviondescent.ShopParticleView
        android:id="@+id/shop_particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Gold display — top right -->
    <TextView
        android:id="@+id/shop_gold_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="42dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="🪙 0"
        android:textColor="@color/gold_bright"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.06"
        android:shadowColor="@color/gold_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:background="@drawable/hud_panel"
        tools:ignore="HardcodedText"/>

    <!-- Centered shop card -->
    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="14dp"
        android:animation="@anim/dialog_open">

        <!-- Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Void Market"
                android:textAllCaps="true"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="#66000000"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Void Market"
                android:textAllCaps="true"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="@color/gold_bright"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="8dp"/>

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/shop_loading"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/gold_bright"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Merchant is preparing..."
                android:textColor="@color/bone_dim"
                android:textSize="14sp"
                android:textStyle="italic"
                android:fontFamily="serif"
                android:letterSpacing="0.04"
                android:layout_marginTop="14dp"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Items: 3 rows of 2 -->
        <LinearLayout
            android:id="@+id/shop_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/shop_row_0"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:id="@+id/shop_row_1"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:id="@+id/shop_row_2"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>

        <!-- Leave button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_shop"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="Leave Shop"
            android:textAllCaps="false"
            android:textColor="@color/bone_dim"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_gothic_secondary"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

</FrameLayout>
