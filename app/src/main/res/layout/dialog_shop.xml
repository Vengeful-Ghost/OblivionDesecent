<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Particle background -->
    <com.example.obliviondescent.ShopParticleView
        android:id="@+id/shop_particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Scrolls instead of clipping on short landscape screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_md">

    <!-- Centered shop card (600dp fits a 640dp landscape phone) -->
    <LinearLayout
        style="@style/OD.Card"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:animation="@anim/dialog_open">

        <!-- Title bar: gold on the left, Leave on the right, so neither can end up off screen -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginBottom="@dimen/space_sm">

            <TextView
                android:id="@+id/shop_gold_display"
                style="@style/OD.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_sm"
                android:text="0"
                android:drawableStart="@drawable/ic_coin"
                android:drawablePadding="@dimen/space_xs"
                android:drawableTint="@color/gold_bright"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:background="@drawable/hud_panel"
                tools:ignore="HardcodedText"/>

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingHorizontal="120dp"
                android:text="The Void Market"
                android:textAllCaps="true"
                android:textColor="@color/shadow_soft"
                android:shadowColor="@color/shadow_hard"
                android:gravity="center"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeMaxTextSize="@dimen/text_title"
                app:autoSizeStepGranularity="1sp"
                android:translationX="2dp"
                android:translationY="2dp"
                tools:ignore="HardcodedText"/>

            <TextView
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingHorizontal="120dp"
                android:text="The Void Market"
                android:textAllCaps="true"
                android:gravity="center"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeMaxTextSize="@dimen/text_title"
                app:autoSizeStepGranularity="1sp"
                android:shadowColor="@color/gold_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"
                tools:ignore="HardcodedText"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_shop"
                style="@style/OD.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="end|center_vertical"
                android:text="Leave"
                android:textColor="@color/bone_dim"
                android:textSize="@dimen/text_small"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/bone_dim"
                tools:ignore="HardcodedText"/>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/shop_loading"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/gold_bright"/>

            <TextView
                style="@style/OD.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Merchant is preparing..."
                android:textStyle="italic"
                android:layout_marginTop="@dimen/space_lg"
                tools:ignore="HardcodedText"/>

        </LinearLayout>

        <!-- Items: 2 rows of 3 -->
        <LinearLayout
            android:id="@+id/shop_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/shop_row_0"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_sm"/>

            <LinearLayout
                android:id="@+id/shop_row_1"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal"/>

        </LinearLayout>

    </LinearLayout>

    </FrameLayout>

    </ScrollView>

</FrameLayout>
