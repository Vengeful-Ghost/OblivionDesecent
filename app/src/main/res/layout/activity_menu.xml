<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainMenuLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E">

    <View
        android:id="@+id/vignetteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_overlay"
        android:alpha="0.92" />

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UserName"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3" />

    <TextView
        android:id="@+id/GameTitleBack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Oblivion Descent"
        android:textAllCaps="true"
        android:textSize="42sp"
        android:textColor="#33000000"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:shadowColor="#99000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="8"
        app:layout_constraintBottom_toTopOf="@+id/MainMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_new_game"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginEnd="16dp"
        android:translationX="-4dp"
        android:translationY="4dp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/GameTitleFront"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Oblivion Descent"
        android:textAllCaps="true"
        android:textSize="42sp"
        android:textColor="#FFD700"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:shadowColor="#FFB700"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="16"
        app:layout_constraintBottom_toBottomOf="@+id/GameTitleBack"
        app:layout_constraintStart_toStartOf="@+id/GameTitleBack"
        app:layout_constraintEnd_toEndOf="@+id/GameTitleBack"
        app:layout_constraintTop_toTopOf="@+id/GameTitleBack"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/MainMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Main Menu"
        android:textAllCaps="true"
        android:textSize="28sp"
        android:textColor="#33000000"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:shadowColor="#99000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="8"
        app:layout_constraintTop_toBottomOf="@id/GameTitleBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/GameTitleBack"
        app:layout_constraintEnd_toEndOf="@+id/GameTitleBack"
        android:layout_marginTop="8dp"
        android:translationX="-4dp"
        android:translationY="4dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_game"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="New Game"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="10"
        android:shadowRadius="3"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:translationZ="8dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_load_game"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/GameTitleBack"
        android:layout_marginBottom="16dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_load_game"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Load Game"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="10"
        android:shadowRadius="3"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:translationZ="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_new_game"
        app:layout_constraintBottom_toTopOf="@+id/btn_stats"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        android:layout_marginBottom="16dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_stats"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Stats"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="10"
        android:shadowRadius="3"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:translationZ="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_load_game"
        app:layout_constraintBottom_toTopOf="@+id/btn_settings"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        android:layout_marginBottom="16dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Settings"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="10"
        android:shadowRadius="3"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:translationZ="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_stats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>