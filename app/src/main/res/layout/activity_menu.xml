<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainMenuLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background">

    <View
        android:id="@+id/vignetteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_overlay"
        android:alpha="0.94"
        android:animation="@anim/slow_pulse" />

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UserName"
        android:textColor="@color/gold_glow"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/hud_panel"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3" />

    <TextView
        android:id="@+id/GameTitleBack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Oblivion Descent"
        android:textAllCaps="true"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="#66000000"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:shadowColor="#CC000000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="10"
        app:layout_constraintBottom_toTopOf="@+id/MainMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_new_game"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginEnd="16dp"
        android:translationX="-5dp"
        android:translationY="5dp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/GameTitleFront"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Oblivion Descent"
        android:textAllCaps="true"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="@color/gold_bright"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:shadowColor="@color/gold_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="18"
        android:animation="@anim/glow_pulse"
        app:layout_constraintBottom_toBottomOf="@+id/GameTitleBack"
        app:layout_constraintStart_toStartOf="@+id/GameTitleBack"
        app:layout_constraintEnd_toEndOf="@+id/GameTitleBack"
        app:layout_constraintTop_toTopOf="@+id/GameTitleBack"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/MainMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Main Menu"
        android:textSize="15sp"
        android:textStyle="italic"
        android:fontFamily="serif"
        android:textColor="@color/bone_dim"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:animation="@anim/fade_in_delayed"
        app:layout_constraintTop_toBottomOf="@id/GameTitleBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/GameTitleBack"
        app:layout_constraintEnd_toEndOf="@+id/GameTitleBack"
        android:layout_marginTop="6dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_game"
        android:layout_width="260dp"
        android:layout_height="62dp"
        android:text="New Game"
        android:textAllCaps="false"
        android:textColor="@color/gold_glow"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.08"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_load_game"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/GameTitleBack"
        android:layout_marginBottom="14dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_load_game"
        android:layout_width="260dp"
        android:layout_height="62dp"
        android:text="Load Game"
        android:textAllCaps="false"
        android:textColor="@color/gold_glow"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.08"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_new_game"
        app:layout_constraintBottom_toTopOf="@+id/btn_stats"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        android:layout_marginBottom="14dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_stats"
        android:layout_width="260dp"
        android:layout_height="62dp"
        android:text="Stats"
        android:textAllCaps="false"
        android:textColor="@color/gold_glow"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.08"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_load_game"
        app:layout_constraintBottom_toTopOf="@+id/btn_settings"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        android:layout_marginBottom="14dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        android:layout_width="260dp"
        android:layout_height="62dp"
        android:text="Settings"
        android:textAllCaps="false"
        android:textColor="@color/gold_glow"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.08"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:backgroundTint="@null"
        android:background="@drawable/btn_login"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_stats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>