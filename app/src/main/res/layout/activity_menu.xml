<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainMenuLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background">

    <View
        android:id="@+id/vignetteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_overlay"
        android:alpha="0.94"
        android:animation="@anim/slow_pulse" />

    <TextView
        android:id="@+id/tvUsername"
        style="@style/OD.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UserName"
        android:textColor="@color/gold_glow"
        android:textSize="@dimen/text_small"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginStart="@dimen/space_xl"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:background="@drawable/hud_panel"
        android:tag="stone"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_tutorial"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_md"
        android:contentDescription="How to play"
        android:text="\?"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold"
        android:fontFamily="@font/cinzel"
        android:textColor="@color/gold_bright"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@null"
        android:background="@drawable/icon_btn_circle"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toEndOf="@id/tvUsername"
        app:layout_constraintTop_toTopOf="@id/tvUsername"
        app:layout_constraintBottom_toBottomOf="@id/tvUsername"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/GameTitleFront"
        style="@style/OD.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Oblivion Descent"
        android:textAllCaps="true"
        android:textSize="48sp"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeMaxTextSize="48sp"
        app:autoSizeStepGranularity="1sp"
        android:gravity="center"
        android:shadowColor="@color/gold_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="18"
        android:animation="@anim/glow_pulse"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/MainMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_new_game"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginEnd="@dimen/space_lg"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/MainMenu"
        style="@style/OD.Text.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Main Menu"
        android:textSize="@dimen/text_body"
        android:textStyle="italic"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:animation="@anim/fade_in_delayed"
        app:layout_constraintTop_toBottomOf="@id/GameTitleFront"
        app:layout_constraintBottom_toTopOf="@+id/menu_extras"
        app:layout_constraintStart_toStartOf="@+id/GameTitleFront"
        app:layout_constraintEnd_toEndOf="@+id/GameTitleFront"
        android:layout_marginTop="@dimen/space_sm"
        tools:ignore="HardcodedText" />

    <!-- Meta progression, the daily challenge, quests and past runs, two by two under the title -->
    <LinearLayout
        android:id="@+id/menu_extras"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintTop_toBottomOf="@id/MainMenu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/GameTitleFront"
        app:layout_constraintEnd_toEndOf="@+id/GameTitleFront">

        <!-- Rows share the column's width, so the pairs never spill past a narrow screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_altar"
                style="@style/OD.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/touch_min"
                android:layout_marginEnd="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:maxLines="1"
                android:textSize="@dimen/text_small"
                android:text="Soul Altar"
                app:icon="@drawable/ic_level"
                app:iconSize="@dimen/icon_sm"
                app:iconPadding="@dimen/space_xs"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_daily"
                style="@style/OD.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/touch_min"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:maxLines="1"
                android:textSize="@dimen/text_small"
                android:text="Daily Run"
                app:icon="@drawable/ic_trophy"
                app:iconSize="@dimen/icon_sm"
                app:iconPadding="@dimen/space_xs"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quests"
                style="@style/OD.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/touch_min"
                android:layout_marginEnd="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:maxLines="1"
                android:textSize="@dimen/text_small"
                android:text="Quests"
                app:icon="@drawable/ic_flag"
                app:iconSize="@dimen/icon_sm"
                app:iconPadding="@dimen/space_xs"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_history"
                style="@style/OD.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/touch_min"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:maxLines="1"
                android:textSize="@dimen/text_small"
                android:text="Runs"
                app:icon="@drawable/ic_hourglass"
                app:iconSize="@dimen/icon_sm"
                app:iconPadding="@dimen/space_xs"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- The Bestiary and this week's challenge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bestiary"
                style="@style/OD.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/touch_min"
                android:layout_marginEnd="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:maxLines="1"
                android:textSize="@dimen/text_small"
                android:text="Bestiary"
                app:icon="@drawable/ic_skull"
                app:iconSize="@dimen/icon_sm"
                app:iconPadding="@dimen/space_xs"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_weekly"
                style="@style/OD.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/touch_min"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:maxLines="1"
                android:textSize="@dimen/text_small"
                android:text="Weekly"
                app:icon="@drawable/ic_crossed_swords"
                app:iconSize="@dimen/icon_sm"
                app:iconPadding="@dimen/space_xs"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_game"
        style="@style/OD.Button"
        android:layout_width="260dp"
        android:layout_height="@dimen/button_height"
        android:text="New Game"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_load_game"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/GameTitleFront"
        android:layout_marginBottom="@dimen/space_md"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_load_game"
        style="@style/OD.Button"
        android:layout_width="260dp"
        android:layout_height="@dimen/button_height"
        android:text="Load Game"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_new_game"
        app:layout_constraintBottom_toTopOf="@+id/btn_coop"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        android:layout_marginBottom="@dimen/space_md"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_coop"
        style="@style/OD.Button"
        android:layout_width="260dp"
        android:layout_height="@dimen/button_height"
        android:text="Co-op"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_load_game"
        app:layout_constraintBottom_toTopOf="@+id/btn_stats"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        android:layout_marginBottom="@dimen/space_md"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_stats"
        style="@style/OD.Button"
        android:layout_width="260dp"
        android:layout_height="@dimen/button_height"
        android:text="Stats"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_coop"
        app:layout_constraintBottom_toTopOf="@+id/btn_settings"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        android:layout_marginBottom="@dimen/space_md"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        style="@style/OD.Button"
        android:layout_width="260dp"
        android:layout_height="@dimen/button_height"
        android:text="Settings"
        android:shadowColor="@color/ink_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:stateListAnimator="@animator/button_elevation_anim"
        android:translationZ="6dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_stats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btn_new_game"
        app:layout_constraintEnd_toEndOf="@+id/btn_new_game"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>