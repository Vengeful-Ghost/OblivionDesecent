<?xml version="1.0" encoding="utf-8"?>
<!-- Compact stat card for multi-column grids: icon, big value, small label -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/space_sm"
    android:foreground="?attr/selectableItemBackground"
    android:background="@drawable/dialog_bg">

    <ImageView
        android:id="@+id/stat_icon"
        android:layout_width="@dimen/icon_lg"
        android:layout_height="@dimen/icon_lg"
        android:layout_marginEnd="@dimen/space_sm"
        android:importantForAccessibility="no"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stat_value"
            style="@style/OD.Text.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/stat_label"
            style="@style/OD.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Highest Floor"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

</LinearLayout>
