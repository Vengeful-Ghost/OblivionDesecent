<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/game_background"
    android:padding="@dimen/space_md"
    tools:ignore="HardcodedText">

    <!-- LEFT: host / join, then party code and actions -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_sm">

        <TextView
            style="@style/OD.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Co-op"
            android:textAllCaps="true"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_md"/>

        <!-- Not in a party yet -->
        <LinearLayout
            android:id="@+id/join_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/OD.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join a party with its code"
                android:layout_marginBottom="@dimen/space_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/input_code"
                    style="@style/OD.Input"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:hint="CODE"
                    android:textColor="@color/gold_glow"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold"
                    android:fontFamily="@font/cinzel"
                    android:letterSpacing="0.3"
                    android:singleLine="true"
                    android:maxLength="6"
                    android:imeOptions="actionGo"
                    android:inputType="textCapCharacters|textNoSuggestions"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_join"
                    style="@style/OD.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="Join"/>

            </LinearLayout>

            <TextView
                style="@style/OD.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="— or —"
                android:textColor="@color/bone_muted"
                android:gravity="center"
                android:layout_marginVertical="@dimen/space_sm"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_host"
                style="@style/OD.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Host a Party"/>

        </LinearLayout>

        <!-- In a party -->
        <LinearLayout
            android:id="@+id/party_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/OD.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Party code (tap to copy)"
                android:gravity="center"
                android:layout_marginBottom="@dimen/space_sm"/>

            <TextView
                android:id="@+id/txt_code"
                style="@style/OD.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="------"
                android:textSize="@dimen/text_display"
                android:letterSpacing="0.3"
                android:gravity="center"
                android:paddingVertical="@dimen/space_xs"
                android:background="@drawable/dialog_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="@dimen/space_md"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_invite"
                style="@style/OD.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:text="Invite Friends"
                android:layout_marginBottom="@dimen/space_sm"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_leave"
                style="@style/OD.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:text="Leave Party"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_lobby"
            style="@style/OD.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="Back"
            app:icon="@drawable/ic_back"/>

    </LinearLayout>

    <!-- RIGHT: party members and start -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/txt_party_title"
            style="@style/OD.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Party"
            android:textAllCaps="true"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_md"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold"
            android:layout_marginBottom="@dimen/space_sm"/>

        <LinearLayout
            android:id="@+id/players_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txt_lobby_status"
            style="@style/OD.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Host a party or join one to begin"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_sm"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/OD.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Start Run"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
