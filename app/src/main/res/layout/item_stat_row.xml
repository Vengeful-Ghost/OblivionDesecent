<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="6dp">

    <ImageView
        android:id="@+id/stat_icon"
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:layout_marginEnd="@dimen/space_md"
        android:importantForAccessibility="no"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/stat_label"
        style="@style/OD.Text.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Highest Floor"
        android:textSize="@dimen/text_body"/>

    <TextView
        android:id="@+id/stat_value"
        style="@style/OD.Text.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"/>

</LinearLayout>
